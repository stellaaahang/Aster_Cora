  "clips": [
    {
      "key": "home-guide-1",
      "language": "en",
      "text": "Hi, I'm Cora, your guide today!",
      "src": "/audio/cora/en-home-guide-1-2cf80424798043f7.mp3"
    },
    {
      "key": "home-guide-2",
      "language": "en",
      "text": "Welcome aboard. Let's explore the future of space robotics together.",
      "src": "/audio/cora/en-home-guide-2-71a294f6943927f5.mp3"
    },
    {
      "key": "companion-greeting",
      "language": "en",
      "text": "Hi! I'm Cora. How are you feeling today?",
      "src": "/audio/cora/en-companion-greeting-34e198e725b8b7b3.mp3"
    },
    {
      "key": "companion-happy",
      "language": "en",
      "text": "That’s good to hear. What made you smile today?",
      "src": "/audio/cora/en-companion-happy-c0ebc2d91c13a370.mp3"
    },
    {
      "key": "companion-down",
      "language": "en",
      "text": "I’m here with you. Would you like to talk, or take a quiet moment together?",
      "src": "/audio/cora/en-companion-down-8876409d1a546b69.mp3"
    },
    {
      "key": "companion-tired",
      "language": "en",
      "text": "You’ve been working hard. Would you like to take a short break?",
      "src": "/audio/cora/en-companion-tired-b06edcb6fbf895fd.mp3"
    },
    {
      "key": "companion-worried",
      "language": "en",
      "text": "Would you like to tell me what’s on your mind? We can take it one step at a time.",
      "src": "/audio/cora/en-companion-worried-a6a5e77bfe711470.mp3"
    },
    {
      "key": "command-locate",
      "language": "en",
      "text": "The tool kit is stored at Rack B-04.",
      "src": "/audio/cora/en-command-locate-888b27a1be3acdec.mp3"
    },
    {
      "key": "command-photo",
      "language": "en",
      "text": "The photo task is ready. Open Photo Logging to frame the scene.",
      "src": "/audio/cora/en-command-photo-4028dc57312d6a79.mp3"
    },
    {
      "key": "command-inventory",
      "language": "en",
      "text": "Here is the sample inventory with its latest recorded locations.",
      "src": "/audio/cora/en-command-inventory-37ddcb5f4ba7f758.mp3"
    },
    {
      "key": "home-guide-1",
      "language": "zh",
      "text": "你好，我是 Cora，今天由我带你探索！",
      "src": "/audio/cora/zh-home-guide-1-c4c9d85bd4df293a.mp3"
    },
    {
      "key": "home-guide-2",
      "language": "zh",
      "text": "欢迎登舱，让我们一起探索太空机器人的未来。",
      "src": "/audio/cora/zh-home-guide-2-525ab2078d6f71ea.mp3"
    },
    {
      "key": "companion-greeting",
      "language": "zh",
      "text": "嗨！我是 Cora。你今天感觉怎么样？",
      "src": "/audio/cora/zh-companion-greeting-ac3e4a0e0dd1812f.mp3"
    },
    {
      "key": "companion-happy",
      "language": "zh",
      "text": "听起来真好。今天有什么让你开心的事？",
      "src": "/audio/cora/zh-companion-happy-1ce422dd7c158a0c.mp3"
    },
    {
      "key": "companion-down",
      "language": "zh",
      "text": "我会在这里陪着你。你想聊一聊，还是一起安静待一会儿？",
      "src": "/audio/cora/zh-companion-down-c4a1cb4e11c54884.mp3"
    },
    {
      "key": "companion-tired",
      "language": "zh",
      "text": "你已经忙碌很久了。要不要短暂休息一下？",
      "src": "/audio/cora/zh-companion-tired-f202a417f29f1ce2.mp3"
    },
    {
      "key": "companion-worried",
      "language": "zh",
      "text": "你愿意说说正在担心什么吗？我们可以一步一步来。",
      "src": "/audio/cora/zh-companion-worried-587eb9056144202c.mp3"
    },
    {
      "key": "command-locate",
      "language": "zh",
      "text": "工具箱在 B-04 储物架。",
      "src": "/audio/cora/zh-command-locate-b732843c0216396f.mp3"
    },
    {
      "key": "command-photo",
      "language": "zh",
      "text": "拍摄任务已准备好。进入拍照记录即可取景。",
      "src": "/audio/cora/zh-command-photo-6b214bb9c47de78a.mp3"
    },
    {
      "key": "command-inventory",
      "language": "zh",
      "text": "这是示例物资清单和最新记录的位置。",
      "src": "/audio/cora/zh-command-inventory-1c6062d34d0af383.mp3"
    }
  ]
}
